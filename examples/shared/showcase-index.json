{
  "$comment": "Shared showcase index. Plain data only: no Vue, no PHP, no renderer, no executable code. Both showcase applications read this file to build the same catalog, so neither can quietly claim support the other does not have. The component list is the frozen public catalog of the reference commit; scripts/ci/check-showcase-routes.mjs fails if it drifts from baseline/reference-inventory.json.",
  "referenceCommit": "fd793696f50d3be0fcd3788f0f8f751c63869963",
  "urlContract": {
    "$comment": "Both applications accept the same query parameters, so a case address is portable between platforms.",
    "parameters": {
      "component": "Public component name, e.g. VfInput.",
      "case": "Stable case id from the component caseSource, e.g. input/clearable-filled.",
      "theme": "light | dark. Applied through each platform native theme mechanism."
    },
    "platforms": {
      "vue": {
        "label": "Vue",
        "path": "/input",
        "$comment": "A route of the historical Vue showcase application at examples/playground. The path is per component, because each component has its own document; see the routes block of each implemented component."
      },
      "razor": {
        "label": "Razor",
        "path": "/",
        "$comment": "The PHP application at examples/razor-showcase, served by its own front controller. One path for every component: the component query parameter selects which catalog it renders."
      }
    }
  },
  "supportStatus": {
    "implemented": "A real adapter implementation renders this component in this platform.",
    "not-implemented": "No adapter implementation exists yet. The component stays visible in the catalog and is never counted as parity-supported."
  },
