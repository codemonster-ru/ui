{
  "name": "codemonster-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "audit:release": "npm audit --omit=dev && npm audit --audit-level=high",
    "build": "npm run build:ui",
    "build:demo": "npm run build -w @codemonster-ru/ui-showcase-example",
    "build:ui": "node ./scripts/ci/run-code-monster-ui-workspaces.mjs build",
    "check": "npm run check:docs && npm run check:ui-packages",
    "check:clean-install": "node ./scripts/ci/check-clean-install.mjs",
    "check:component-documentation": "node --test ./scripts/ci/component-documentation.test.mjs && node ./scripts/ci/check-component-documentation.mjs",
    "check:composer-packed-consumer": "node ./scripts/ci/check-code-monster-ui-composer-packed-consumer.mjs",
    "check:composer-registry-consumer": "node ./scripts/ci/check-code-monster-ui-composer-registry-consumer.mjs",
    "check:consumer-tree-shaking": "node ./scripts/ci/check-consumer-tree-shaking.mjs",
    "check:docs": "node --test ./scripts/ci/documentation-fences.test.mjs && node ./scripts/ci/check-documentation-contracts.mjs && npm run check:component-documentation",
    "check:docs:examples": "node --test ./scripts/ci/documentation-example-paths.test.mjs && node ./scripts/ci/check-documentation-examples.mjs",
    "check:package-contracts": "node --test ./scripts/ci/code-monster-ui-package-contracts.test.mjs && node ./scripts/ci/check-package-contracts.mjs",
    "check:packed-consumer": "node ./scripts/ci/check-code-monster-ui-packed-consumer.mjs --manager=npm && node ./scripts/ci/check-code-monster-ui-css-packed-consumer.mjs --manager=npm",
    "check:packed-consumers": "node ./scripts/ci/run-packed-consumer-managers.mjs",
    "check:razor-package": "node ./scripts/ci/check-razor-package.mjs",
    "check:repository-contracts": "npm run check:docs",
    "check:ui-accessibility": "node --test ./scripts/contracts/accessibility.test.mjs && node ./scripts/ci/check-code-monster-ui-accessibility.mjs",
    "check:ui-behavior-scenarios": "node --test ./scripts/contracts/behavior-scenarios.test.mjs && node ./scripts/ci/check-code-monster-ui-behavior-scenarios.mjs",
    "check:ui-component-manifests": "node --test ./scripts/contracts/component-manifests.test.mjs && node ./scripts/ci/check-code-monster-ui-component-manifests.mjs",
    "check:ui-component-selectors": "node --test ./scripts/contracts/component-selectors.test.mjs",
    "check:ui-composer-split": "node ./scripts/ci/check-code-monster-ui-composer-split.mjs",
    "check:ui-contract-cases": "node --test ./scripts/contracts/component-cases.test.mjs && node ./scripts/ci/check-code-monster-ui-contract-cases.mjs",
    "check:ui-contracts": "npm run check:ui-package-metadata && npm run check:ui-composer-split && npm run check:ui-component-manifests && npm run check:ui-contract-cases && npm run check:ui-behavior-scenarios && npm run check:ui-controller-coverage && npm run check:ui-significant-dom && npm run check:ui-component-selectors && npm run check:ui-razor-assets",
    "check:ui-controller-coverage": "node --test ./scripts/contracts/controller-coverage.test.mjs && node ./scripts/contracts/check-controller-coverage.mjs",
    "check:ui-package-budgets": "node --test ./scripts/ci/code-monster-ui-package-budgets.test.mjs && node ./scripts/ci/check-code-monster-ui-package-budgets.mjs",
    "check:ui-package-metadata": "node --test ./scripts/ci/code-monster-ui-package-metadata.test.mjs ./scripts/ci/code-monster-ui-workspaces.test.mjs && node ./scripts/ci/check-code-monster-ui-package-metadata.mjs",
    "check:ui-packages": "node ./scripts/ci/run-code-monster-ui-workspaces.mjs check",
    "check:ui-razor-assets": "node --test ./scripts/ci/code-monster-ui-razor-assets.test.mjs",
    "check:ui-registry-consumer": "node ./scripts/ci/check-code-monster-ui-registry-consumer.mjs",
    "check:ui-significant-dom": "node --test ./scripts/contracts/significant-dom.test.mjs ./scripts/contracts/significant-dom-conformance.test.mjs",
    "check:ui-visual-fixtures": "node --test ./scripts/visual/code-monster-ui-fixtures.test.mjs ./scripts/visual/compare-showcase.test.mjs ./scripts/visual/cross-platform-baselines.test.mjs ./scripts/visual/cross-platform-browser.test.mjs && node ./scripts/ci/check-code-monster-ui-visual-fixtures.mjs",
    "check:verify-coverage": "node --test ./scripts/ci/verify-coverage.test.mjs && node ./scripts/ci/check-verify-coverage.mjs",
    "dev": "npm run dev -w @codemonster-ru/ui-showcase-example",
    "dev:demo": "npm run dev -w @codemonster-ru/ui-showcase-example",
    "dev:razor": "docker compose -f examples/razor/compose.yaml up --build razor",
    "dev:razor:local": "composer run dev --working-dir=examples/razor",
    "format": "npm run format --workspaces --if-present --include-workspace-root=false",
    "format:check": "npm run format:check --workspaces --if-present --include-workspace-root=false",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "npm run lint --workspaces --if-present --include-workspace-root=false",
    "lint:all": "npm run lint && npm run lint:styles && npm run lint:html && npm run lint:md && npm run lint:data",
    "lint:data": "prettier --check \"**/*.{json,yml,yaml}\"",
    "lint:html": "htmlhint \"**/*.html\" --format unix --nocolor",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:styles": "stylelint \"**/*.{css,scss,sass,vue}\" --allow-empty-input --formatter unix",
    "pack:all:dry-run": "npm run pack:ui:dry-run",
    "pack:ui:dry-run": "npm_config_cache=.npm-cache npm pack --workspace @codemonster-ru/ui-tokens --dry-run --ignore-scripts && npm_config_cache=.npm-cache npm pack --workspace @codemonster-ru/ui-runtime --dry-run --ignore-scripts && npm_config_cache=.npm-cache npm pack --workspace @codemonster-ru/ui-css --dry-run --ignore-scripts && npm_config_cache=.npm-cache npm pack --workspace @codemonster-ru/ui-utilities --dry-run --ignore-scripts && npm_config_cache=.npm-cache npm pack --workspace @codemonster-ru/ui-vue --dry-run --ignore-scripts",
    "prepare": "npm run hooks:install",
    "prepublish:all": "npm run build && npm run pack:all:dry-run",
    "prepublish:ui": "npm run build:ui && npm run pack:ui:dry-run",
    "sync:ui-razor-assets": "node ./scripts/ci/sync-code-monster-ui-razor-assets.mjs",
    "test": "npm run test --workspaces --if-present --include-workspace-root=false && npm run test:ui",
    "test:ci-like": "scripts/ci/test-without-dist.sh",
    "test:release-prep": "node --test ./scripts/ci/prepare-release-from-tag.test.mjs ./scripts/ci/verify-chain.test.mjs",
    "test:ui": "npm run check:ui-contracts && npm run check:ui-accessibility && npm run check:ui-visual-fixtures",
    "test:ui-css-packed-consumer": "node --test ./scripts/ci/code-monster-ui-css-consumer.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present --include-workspace-root=false",
    "verify": "npm run check:clean-install && npm run audit:release && npm run lint:all && npm run format:check && npm run build && npm run typecheck && npm run check:repository-contracts && npm run check:verify-coverage && npm run check:razor-package && npm run test:ui && npm run test:ci-like && npm run check:docs:examples && npm run test:release-prep && npm run check:package-contracts && npm run check:ui-package-budgets && npm run check:packed-consumers && npm run check:consumer-tree-shaking && npm run pack:all:dry-run",
    "visual:cross-platform:capture": "node ./scripts/visual/capture-cross-platform-cases.mjs",
    "visual:cross-platform:razor-render": "node ./scripts/visual/render-cross-platform-cases.mjs",
    "visual:cross-platform:serve": "node ./scripts/visual/serve-cross-platform-cases.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/compiler-sfc": "3.5.35",
    "@vue/language-core": "~3.3.8",
    "ajv": "^8.17.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "htmlhint": "^1.7.1",
    "jsdom": "^26.1.0",
    "markdownlint-cli2": "^0.23.1",
    "parse5": "^8.0.1",
    "prettier": "^3.6.2",
    "semver": "^7.7.4",
    "stylelint": "^16.25.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vue": "3.5.35",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "@vitejs/plugin-vue": "5.2.4",
    "js-beautify": "npm:js-beautify@2.0.3",
    "markdownlint-cli2": {
      "js-yaml": "5.2.2"
    },
    "tsup": {
      "esbuild": "0.27.2"
    },
    "vite": "6.4.3",
    "ws": "8.21.0",
    "vue": "3.5.35",
    "@vue/server-renderer": "3.5.35"
  }
}
