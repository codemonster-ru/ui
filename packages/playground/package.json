{
  "name": "@codemonster-ru/vueforge-playground",
  "version": "3.0.1",
  "description": "Vue 3 playground UI adapter for the VueForge playground core runtime.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/codemonster-ru/ui/tree/main/packages/playground#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/ui.git",
    "directory": "packages/playground"
  },
  "keywords": [
    "vue",
    "vue3",
    "playground",
    "sandbox",
    "vueforge"
  ],
  "exports": {
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "node": "./dist/ui.js",
        "default": "./dist/auto/ui.js"
      }
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./style.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css",
    "./playground.css": "./dist/playground.css",
    "./critical.css": "./dist/critical.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemonster-ru/vueforge-playground-core": "^2.1.0",
    "@codemonster-ru/vueforge-codeblock": "^4.0.0",
    "@codemonster-ru/vueforge-core": "^2.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.4.11",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "^3.5.35",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.20",
    "vue-tsc": "^3.3.8"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && vue-tsc --emitDeclarationOnly --declaration --declarationDir dist && node ../../scripts/build/finalize-declarations.mjs dist",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "prepack": "npm run build",
    "smoke:css-export": "node ./scripts/smoke-css-export.mjs",
    "smoke:consumer-auto-css": "node ./scripts/smoke-consumer-auto-css.mjs",
    "test": "npm run smoke:css-export && npm run smoke:consumer-auto-css && vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "dist/auto/*.js"
  ]
}
