{
  "name": "@codemonster-ru/ui-css",
  "version": "2.0.0-dev.0",
  "description": "Framework-independent foundation and component styles for CodeMonster UI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/codemonster-ru/ui/tree/main/packages/css#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/ui.git",
    "directory": "packages/css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/*.css"
  ],
  "exports": {
    "./accordion.css": "./dist/components/accordion.css",
    "./admin-layout.css": "./dist/components/admin-layout.css",
    "./admin-shell.css": "./dist/components/admin-shell.css",
    "./alert.css": "./dist/components/alert.css",
    "./avatar.css": "./dist/components/avatar.css",
    "./badge.css": "./dist/components/badge.css",
    "./breadcrumbs.css": "./dist/components/breadcrumbs.css",
    "./button.css": "./dist/components/button.css",
    "./card.css": "./dist/components/card.css",
    "./checkbox.css": "./dist/components/checkbox.css",
    "./column-chooser.css": "./dist/components/column-chooser.css",
    "./command-palette.css": "./dist/components/command-palette.css",
    "./container.css": "./dist/components/container.css",
    "./data-table.css": "./dist/components/data-table.css",
    "./date-picker.css": "./dist/components/date-picker.css",
    "./dialog.css": "./dist/components/dialog.css",
    "./divider.css": "./dist/components/divider.css",
    "./drawer.css": "./dist/components/drawer.css",
    "./dropdown.css": "./dist/components/dropdown.css",
    "./field.css": "./dist/components/field.css",
    "./fieldset.css": "./dist/components/fieldset.css",
    "./fonts.css": "./dist/fonts.css",
    "./foundation.css": "./dist/foundation.css",
    "./grid.css": "./dist/components/grid.css",
    "./icon-button.css": "./dist/components/icon-button.css",
    "./inline.css": "./dist/components/inline.css",
    "./input.css": "./dist/components/input.css",
    "./link.css": "./dist/components/link.css",
    "./menu-bar.css": "./dist/components/menu-bar.css",
    "./menu.css": "./dist/components/menu.css",
    "./nav-menu.css": "./dist/components/nav-menu.css",
    "./popover.css": "./dist/components/popover.css",
    "./progress-bar.css": "./dist/components/progress-bar.css",
    "./progress-spinner.css": "./dist/components/progress-spinner.css",
    "./radio.css": "./dist/components/radio.css",
    "./section.css": "./dist/components/section.css",
    "./select.css": "./dist/components/select.css",
    "./setup-layout.css": "./dist/components/setup-layout.css",
    "./skeleton.css": "./dist/components/skeleton.css",
    "./stack.css": "./dist/components/stack.css",
    "./stepper.css": "./dist/components/stepper.css",
    "./styles.css": "./dist/styles.css",
    "./switch.css": "./dist/components/switch.css",
    "./table-of-contents.css": "./dist/components/table-of-contents.css",
    "./table.css": "./dist/components/table.css",
    "./tabs.css": "./dist/components/tabs.css",
    "./tag.css": "./dist/components/tag.css",
    "./textarea.css": "./dist/components/textarea.css",
    "./theme-switch.css": "./dist/components/theme-switch.css",
    "./tooltip.css": "./dist/components/tooltip.css"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "prepack": "npm run build",
    "test": "npm run build && node --test ./__tests__/*.test.mjs",
    "typecheck": "node --check ./scripts/build.mjs"
  },
  "keywords": [
    "codemonster-ui",
    "css",
    "design-system"
  ],
  "dependencies": {
    "@codemonster-ru/ui-tokens": "^2.0.0-dev.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0"
  }
}
