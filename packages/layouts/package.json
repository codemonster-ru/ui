{
  "name": "@codemonster-ru/ui-layouts",
  "version": "2.0.0-dev.0",
  "description": "Page layouts for CodeMonster UI, rendered by the Vue adapter.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/codemonster-ru/ui/tree/main/packages/ui-layouts#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/ui.git",
    "directory": "packages/ui-layouts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run src --passWithNoTests && npm run build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "codemonster-ui",
    "layouts",
    "vue",
    "vue3"
  ],
  "peerDependencies": {
    "@codemonster-ru/ui-css": "^2.0.0-dev.0",
    "@codemonster-ru/ui-vue": "^2.0.0-dev.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "3.5.35",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.4",
    "vue": "3.5.35",
    "vue-tsc": "^3.3.8"
  }
}
