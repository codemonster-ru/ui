{
  "name": "@codemonster-ru/vueforge-layouts",
  "version": "2.1.1",
  "description": "Layout primitives, shell components, and responsive composables for Vue 3 applications.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/codemonster-ru/vueforge/tree/main/packages/layouts#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/vueforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/vueforge.git",
    "directory": "packages/layouts"
  },
  "author": "Kirill Kolesnikov (https://github.com/kolesnikovKirill)",
  "sideEffects": [
    "**/*.css",
    "dist/auto/*.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./container": {
      "import": {
        "types": "./dist/container.d.ts",
        "node": "./dist/node/container.js",
        "default": "./dist/auto/container.js"
      }
    },
    "./stack": {
      "import": {
        "types": "./dist/stack.d.ts",
        "node": "./dist/node/stack.js",
        "default": "./dist/auto/stack.js"
      }
    },
    "./inline": {
      "import": {
        "types": "./dist/inline.d.ts",
        "node": "./dist/node/inline.js",
        "default": "./dist/auto/inline.js"
      }
    },
    "./section": {
      "import": {
        "types": "./dist/section.d.ts",
        "node": "./dist/node/section.js",
        "default": "./dist/auto/section.js"
      }
    },
    "./grid": {
      "import": {
        "types": "./dist/grid.d.ts",
        "node": "./dist/node/grid.js",
        "default": "./dist/auto/grid.js"
      }
    },
    "./app-shell": {
      "import": {
        "types": "./dist/app-shell.d.ts",
        "node": "./dist/node/app-shell.js",
        "default": "./dist/auto/app-shell.js"
      }
    },
    "./admin-layout": {
      "import": {
        "types": "./dist/admin-layout.d.ts",
        "node": "./dist/node/admin-layout.js",
        "default": "./dist/auto/admin-layout.js"
      }
    },
    "./admin-shell": {
      "import": {
        "types": "./dist/admin-shell.d.ts",
        "node": "./dist/node/admin-shell.js",
        "default": "./dist/auto/admin-shell.js"
      }
    },
    "./document-layout": {
      "import": {
        "types": "./dist/document-layout.d.ts",
        "node": "./dist/node/document-layout.js",
        "default": "./dist/auto/document-layout.js"
      }
    },
    "./auth-layout": {
      "import": {
        "types": "./dist/auth-layout.d.ts",
        "node": "./dist/node/auth-layout.js",
        "default": "./dist/auto/auth-layout.js"
      }
    },
    "./error-layout": {
      "import": {
        "types": "./dist/error-layout.d.ts",
        "node": "./dist/node/error-layout.js",
        "default": "./dist/auto/error-layout.js"
      }
    },
    "./setup-layout": {
      "import": {
        "types": "./dist/setup-layout.d.ts",
        "node": "./dist/node/setup-layout.js",
        "default": "./dist/auto/setup-layout.js"
      }
    },
    "./header-area": {
      "import": {
        "types": "./dist/header-area.d.ts",
        "node": "./dist/node/header-area.js",
        "default": "./dist/auto/header-area.js"
      }
    },
    "./sidebar-area": {
      "import": {
        "types": "./dist/sidebar-area.d.ts",
        "node": "./dist/node/sidebar-area.js",
        "default": "./dist/auto/sidebar-area.js"
      }
    },
    "./content-area": {
      "import": {
        "types": "./dist/content-area.d.ts",
        "node": "./dist/node/content-area.js",
        "default": "./dist/auto/content-area.js"
      }
    },
    "./aside-area": {
      "import": {
        "types": "./dist/aside-area.d.ts",
        "node": "./dist/node/aside-area.js",
        "default": "./dist/auto/aside-area.js"
      }
    },
    "./footer-area": {
      "import": {
        "types": "./dist/footer-area.d.ts",
        "node": "./dist/node/footer-area.js",
        "default": "./dist/auto/footer-area.js"
      }
    },
    "./breakpoints.css": "./dist/breakpoints.css",
    "./base.css": "./dist/base.css",
    "./container.css": "./dist/container.css",
    "./stack.css": "./dist/stack.css",
    "./inline.css": "./dist/inline.css",
    "./section.css": "./dist/section.css",
    "./grid.css": "./dist/grid.css",
    "./app-shell.css": "./dist/app-shell.css",
    "./admin-layout.css": "./dist/admin-layout.css",
    "./admin-shell.css": "./dist/admin-shell.css",
    "./document-layout.css": "./dist/document-layout.css",
    "./auth-layout.css": "./dist/auth-layout.css",
    "./error-layout.css": "./dist/error-layout.css",
    "./setup-layout.css": "./dist/setup-layout.css",
    "./header-area.css": "./dist/header-area.css",
    "./sidebar-area.css": "./dist/sidebar-area.css",
    "./content-area.css": "./dist/content-area.css",
    "./aside-area.css": "./dist/aside-area.css",
    "./footer-area.css": "./dist/footer-area.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && vite build --mode cjs && node ../../scripts/build/finalize-declarations.mjs dist",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --ignore-path ../../.prettierignore . --write",
    "format:check": "prettier --ignore-path ../../.prettierignore . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "test": "npm run check:css-contract && npm run smoke:css-export && npm run smoke:cjs-ssr && vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "smoke:css-export": "node ./scripts/smoke-css-export.mjs",
    "smoke:cjs-ssr": "node ./scripts/smoke-cjs-ssr.mjs",
    "check:css-contract": "node ./scripts/check-css-contract.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@codemonster-ru/vueforge-core": "^2.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemonster-ru/vueforge-theme": "^2.0.0"
  },
  "devDependencies": {
    "@codemonster-ru/vueforge-core": "file:../core",
    "@codemonster-ru/vueforge-icons": "file:../icons",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/language-core": "~3.3.8",
    "@vue/server-renderer": "^3.5.13",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^6.4.2",
    "vitest": "^3.0.8",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^3.3.8"
  },
  "keywords": [
    "vue",
    "vue3",
    "layout",
    "app-shell",
    "responsive",
    "docs",
    "shell",
    "composables",
    "vueforge"
  ],
  "overrides": {
    "flatted": "3.4.2"
  }
}
