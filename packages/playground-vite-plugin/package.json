{
  "name": "@codemonster-ru/vueforge-playground-vite-plugin",
  "version": "1.0.0",
  "description": "Vite plugin for VueForge playground virtual modules",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/codemonster-ru/codemonster-ui/tree/main/packages/playground-vite-plugin#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/codemonster-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/codemonster-ui.git",
    "directory": "packages/playground-vite-plugin"
  },
  "keywords": [
    "vite",
    "playground",
    "vueforge",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external vite",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
