{
  "name": "codemonster-ru/ui-razor",
  "description": "CodeMonster UI components and assets for Annabel Razor.",
  "type": "library",
  "license": "MIT",
  "support": {
    "source": "https://github.com/codemonster-ru/ui-razor"
  },
  "require": {
    "php": ">=8.2",
    "codemonster-ru/razor": "^2.1",
    "codemonster-ru/view": "^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Codemonster\\Ui\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codemonster\\Ui\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/phpstan.neon.dist",
      "/phpunit.xml.dist",
      "/tests"
    ]
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
    "test": "phpunit --configuration=phpunit.xml.dist",
    "check": [
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
