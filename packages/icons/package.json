{
  "name": "@codemonster-ru/vueforge-icons",
  "version": "2.0.0",
  "description": "Open-source Vue 3 icon library for the VueForge ecosystem.",
  "keywords": [
    "vue",
    "vue3",
    "icons",
    "icon-library",
    "svg-icons",
    "design-system",
    "vueforge"
  ],
  "homepage": "https://github.com/codemonster-ru/vueforge/tree/main/packages/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/vueforge.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/codemonster-ru/vueforge/issues"
  },
  "author": "Kirill Kolesnikov",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.d.ts",
        "node": "./dist/index.node.mjs",
        "default": "./dist/index.ts.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "dist/index.ts.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev --force --mode development",
    "audit:icons": "node ./scripts/audit-icons.mjs",
    "audit:icons:check": "node ./scripts/audit-icons.mjs --validate-only",
    "audit:centering": "node ./scripts/audit-icon-centering.mjs",
    "snapshot:reference": "node ./scripts/snapshot-reference-icons.mjs",
    "snapshot:batch2": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch02.json --output=src/lib/iconMigrationBatch02Before.json",
    "snapshot:batch3": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch03.json --output=src/lib/iconMigrationBatch03Before.json",
    "snapshot:batch4": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch04.json --output=src/lib/iconMigrationBatch04Before.json",
    "snapshot:batch5": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch05.json --output=src/lib/iconMigrationBatch05Before.json",
    "snapshot:batch6": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch06.json --output=src/lib/iconMigrationBatch06Before.json",
    "snapshot:batch7": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch07.json --output=src/lib/iconMigrationBatch07Before.json",
    "snapshot:batch8": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch08.json --output=src/lib/iconMigrationBatch08Before.json",
    "snapshot:batch9": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch09.json --output=src/lib/iconMigrationBatch09Before.json",
    "snapshot:batch10": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch10.json --output=src/lib/iconMigrationBatch10Before.json",
    "snapshot:batch11": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch11.json --output=src/lib/iconMigrationBatch11Before.json",
    "snapshot:batch12": "node ./scripts/snapshot-reference-icons.mjs --set=src/lib/iconMigrationBatch12.json --output=src/lib/iconMigrationBatch12Before.json",
    "create-icon": "node ./scripts/create-icon.mjs",
    "generate": "node ./scripts/generate-icons.mjs",
    "validate-icons": "node ./scripts/generate-icons.mjs --validate-only && npm run audit:icons:check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "lint": "eslint .",
    "build": "npm run generate && vite build --mode production && node ../../scripts/build/finalize-declarations.mjs dist",
    "build:showcase": "vite build --config vite.showcase.config.mts",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run smoke && npm run render",
    "render": "node ./__tests__/render-consumer.mjs",
    "smoke": "npm run build && tsc -p tsconfig.smoke.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/server-renderer": "^3.5.12",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.2",
    "sass": "~1.99.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vue": "^3.5.12",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^3.3.8"
  }
}
