{
  "name": "@codemonster-ru/ui-icons",
  "version": "2.0.0-dev.0",
  "description": "Framework-independent icon data for CodeMonster UI.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node ./scripts/generate-icons.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "npm run build && node --test ./__tests__/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/codemonster-ru/ui/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/ui/issues"
  },
  "keywords": [
    "codemonster-ui",
    "design-system",
    "theme",
    "tokens"
  ],
  "sideEffects": [
    "./dist/*.css"
  ]
}
