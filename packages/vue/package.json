{
  "name": "@codemonster-ru/ui-vue",
  "version": "2.0.0",
  "description": "Vue 3 adapter for CodeMonster UI components.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://github.com/codemonster-ru/ui/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/codemonster-ru/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonster-ru/ui.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/historical-entries/browser/*.js",
    "./dist/historical-entries/shared-styles.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./historical": {
      "types": "./dist/historical.d.ts",
      "import": "./dist/historical.js",
      "module-sync": "./dist/historical.js"
    },
    "./historical/*": {
      "types": "./dist/historical-entries/node/*.d.ts",
      "browser": "./dist/historical-entries/browser/*.js",
      "import": "./dist/historical-entries/node/*.js",
      "module-sync": "./dist/historical-entries/node/*.js"
    }
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build/build-historical-component-entries.mjs && node ../../scripts/build/finalize-declarations.mjs dist",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run src && npm run build && node --test ./__tests__/*.test.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "codemonster-ui",
    "components",
    "vue",
    "vue3"
  ],
  "peerDependencies": {
    "@codemonster-ru/ui-css": "^2.0.0",
    "@codemonster-ru/ui-icons": "^2.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemonster-ru/floater.js": "^1.0.11",
    "@codemonster-ru/ui-runtime": "^2.0.0",
    "@codemonster-ru/ui-tokens": "^2.0.0"
  },
  "devDependencies": {
    "@codemonster-ru/ui-icons": "file:../icons",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "3.5.45",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vue": "3.5.45",
    "vue-tsc": "^3.3.8"
  }
}
