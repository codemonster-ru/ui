{
  "$comment": "Shared input/expected vectors for VfNavMenu. The TypeScript rules in nav-menu/state.ts run every section; the PHP mirror in packages/razor/src/Support/NavMenuState.php runs the sections a server can decide (listed in $serverRules) and deliberately has no method for the other two - a toggle is a click and a measurement is a browser's, neither of which a server ever has. The contract of the reference at fd793696, quirks included: an item with children [] is a leaf; a group is never a branch; href '' is a link; the ancestry is the path to the first match in document order, group values included, and a top-level match has none; activation only adds, current values first; closing removes one value and keeps the descendants; single mode removes the sibling branches and every branch below them, skips a sibling group whole and keeps the opened branch's own descendants; only the sidebar is compact, an explicit compact wins both ways, and a probe with no width never makes it compact. An absent key is `undefined`.",
  "$serverRules": [
    "resolveNavMenuAncestorValues",
    "resolveNavMenuBranchClasses",
    "resolveNavMenuCollapseClasses",
    "resolveNavMenuCompact",
    "resolveNavMenuGroupClasses",
    "resolveNavMenuHasDescendant",
    "resolveNavMenuIconClasses",
    "resolveNavMenuIsBranch",
    "resolveNavMenuIsLink",
    "resolveNavMenuIsSimple",
    "resolveNavMenuLeafClasses",
    "resolveNavMenuNodeClasses",
    "resolveNavMenuRootClasses",
    "resolveNavMenuShowsExternalIcon",
    "resolveNavMenuSyncedExpandedValues"
  ],
  "constants": {
    "NAV_MENU_COLLAPSE_TRANSITION": "height var(--vf-motion-duration-normal) var(--vf-motion-ease-standard), opacity var(--vf-motion-duration-normal) var(--vf-motion-ease-standard)"
  },
