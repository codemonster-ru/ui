{
  "schemaVersion": 1,
  "name": "DocumentLayout",
  "slug": "document-layout",
  "description": "A reading frame of header, subheader, chapter sidebar, body, contextual aside and footer. Sticky offsets are published as custom properties that read from declared heights, so the layout is correct before any script runs; a controller narrows them to the observed heights afterwards.",
  "props": {
    "layout": {
      "type": "enum",
      "required": false,
      "default": "content",
      "values": ["content", "sidebar-content", "sidebar-content-aside"]
    },
    "as": { "type": "string", "required": false, "default": "div" },
    "fillViewport": { "type": "boolean", "required": false, "default": false },
    "edgeNotches": { "type": "boolean", "required": false, "default": false },
    "showSubheader": { "type": "boolean", "required": false, "default": true },
    "showContentSubheader": { "type": "boolean", "required": false, "default": true },
    "stickyHeader": { "type": "boolean", "required": false, "default": false },
    "stickySidebar": { "type": "boolean", "required": false, "default": false },
    "stickyAside": { "type": "boolean", "required": false, "default": false }
  },
  "slots": {
    "default": {
      "required": true,
      "description": "Document body."
    },
    "header": {
      "required": false,
      "description": "Document header."
    },
    "subheader": {
      "required": false,
      "description": "Secondary bar below the header."
    },
    "sidebar": {
      "required": false,
      "description": "Chapter navigation."
    },
    "aside": {
      "required": false,
      "description": "Contextual panel, such as an on-this-page list."
    },
    "footer": {
      "required": false,
      "description": "Document footer."
    }
  },
  "events": {},
  "states": []
}
