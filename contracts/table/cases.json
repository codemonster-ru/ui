{
  "$comment": "Shared VfTable cases. Plain data only. The vocabulary is the historical Vue contract at fd793696f50d3be0fcd3788f0f8f751c63869963. The table owns no interaction and no id: every case is static. A row group is opened by the presence of its slot, so the catalog spells presence explicitly - a slot with rows: 0 is present and renders nothing, an absent key is no slot at all - and the Razor fixture hands slots over through the PHP API, where absence is explicit, never through a template invocation, where any content declares the default slot (plan section У.8). Cases whose content or attributes add a focusable element declare consumerInteractive. VfDataTable has no cases here.",
  "component": "table",
  "propVocabulary": {
    "caption": "string, default undefined. Opens the caption by JavaScript truthiness.",
    "columnDividers": "boolean, default false.",
    "compact": "boolean, default false.",
    "striped": "boolean, default false.",
    "stickyHeader": "boolean, default false. A class only; the stylesheet does the rest."
  },
  "slotVocabulary": {
    "caption": "text or markup rich; replaces the prop and counts by presence.",
    "header": "rows: the number of header rows (0 renders nothing).",
    "body": "The default slot. rows: the number of member rows (0 renders nothing); control: true adds a row with a consumer button.",
    "footer": "rows: the number of footer rows (0 renders nothing)."
  },
