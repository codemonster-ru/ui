{
  "schemaVersion": 1,
  "name": "Textarea",
  "slug": "textarea",
  "razorTag": "cm-textarea",
  "description": "A native multiline text control with shared sizing and validation presentation.",
  "props": {
    "value": { "type": "string", "required": false, "default": "" },
    "size": {
      "type": "enum",
      "required": false,
      "default": "md",
      "values": ["sm", "md", "lg"]
    },
    "invalid": { "type": "boolean", "required": false, "default": false },
    "disabled": { "type": "boolean", "required": false, "default": false },
    "readonly": { "type": "boolean", "required": false, "default": false },
    "required": { "type": "boolean", "required": false, "default": false }
  },
  "slots": {},
  "events": {
    "input": { "description": "Native input event carrying the current DOM value.", "native": true },
    "change": { "description": "Native committed-value change event.", "native": true }
  },
  "states": ["default", "disabled", "readonly", "invalid"],
  "relatedComponents": ["Field"]
}
