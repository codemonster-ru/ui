{
  "schemaVersion": 1,
  "name": "Drawer",
  "slug": "drawer",
  "description": "A modal sheet at a logical inline edge or the top or bottom of the viewport.",
  "props": {
    "id": { "type": "string", "required": true },
    "title": { "type": "string", "required": false },
    "description": { "type": "nullable", "required": false, "default": null },
    "open": { "type": "boolean", "required": false, "default": false },
    "defaultOpen": { "type": "boolean", "required": false, "default": false },
    "side": {
      "type": "enum",
      "required": false,
      "default": "end",
      "values": ["start", "end", "left", "right", "top", "bottom"]
    },
    "ariaLabel": { "type": "string", "required": false },
    "ariaLabelledby": { "type": "string", "required": false },
    "ariaDescribedby": { "type": "string", "required": false },
    "closeLabel": { "type": "string", "required": false, "default": "Close" },
    "dismissible": { "type": "boolean", "required": false, "default": true },
    "closable": { "type": "boolean", "required": false, "default": true },
    "closeOnEscape": { "type": "boolean", "required": false, "default": true },
    "closeOnOverlayClick": { "type": "boolean", "required": false, "default": false },
    "focusDrawer": { "type": "boolean", "required": false, "default": false },
    "offsetTop": { "type": "nullable-css-length", "required": false },
    "bodyPadding": { "type": "nullable-css-length", "required": false },
    "size": { "type": "enum", "required": false, "default": "md", "values": ["sm", "md", "lg", "full"] },
    "dividers": { "type": "boolean", "required": false, "default": false },
    "rounded": { "type": "boolean", "required": false, "default": false }
  },
  "slots": {
    "default": { "required": false },
    "header": { "required": false },
    "description": { "required": false },
    "actions": { "required": false },
    "footer": { "required": false }
  },
  "events": {
    "openChange": { "description": "Reports the next modal state.", "payloadContract": "boolean" }
  },
  "states": ["closed", "open"]
}
