        "title": "Invoice details",
        "collapsible": true
      },
      "attrs": {},
      "content": {
        "body": {
          "text": "Invoice #1024 · Design service · $120.00"
        }
      },
      "componentInteractive": 1,
      "interaction": {
        "steps": [
          {
            "action": "focusButton",
            "selector": ".vf-group-box__trigger"
          },
          {
            "action": "pressKey",
            "key": "Enter"
          }
        ],
