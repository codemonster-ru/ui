{
  "$comment": "Shared VfGroupBox cases. Plain data only: no Vue, no PHP, no renderer objects. Each adapter maps these neutral fields onto its own API. The vocabulary is the historical Vue contract at fd793696f50d3be0fcd3788f0f8f751c63869963. Every case declares `componentInteractive` - zero for a static group (untitled, titled and not collapsible, collapsible without a title), one trigger per collapsible instance otherwise - and `consumerInteractive` where a slot holds a control. An interaction case names the gesture, the effect it must produce on every target, and the initial case whose DOM the result must converge on. scripts/ci/group-box-coverage.mjs is what stops the list eroding.",
  "component": "group-box",
  "propVocabulary": {
    "title": "string, default undefined. JavaScript truthiness decides whether there is a title: \"\" is none, \"0\" is one. Rendered in the title span unless a title slot replaces it.",
    "collapsible": "boolean, default false. The disclosure exists only when there is also a title (prop or slot).",
    "collapsed": "boolean | undefined, default undefined. The controlled state; wins whenever defined. A Vue consumer pairs it with update:collapsed (v-model:collapsed). The Razor adapter reads it as the initial state and toggles on its own - the documented platform divergence (parity-policy.json, platformDivergences).",
    "defaultCollapsed": "boolean, default false. Seeds the uncontrolled state; read once.",
    "disabled": "boolean, default false. The native disabled attribute on the trigger and nothing else; never on the fieldset. Does nothing without collapsible."
  },
  "contentVocabulary": {
    "title": "The title slot. `text` is plain text, `markup: rich` is consumer <strong>/<em>, `control` is a real consumer link (inside the trigger when collapsible).",
    "toggleIcon": "The toggle-icon slot. `text` replaces the whole aria-hidden icon wrapper.",
    "body": "The default slot, rendered directly in div.vf-group-box__content while open. `text`, `markup: paragraphs`, `control` (a real consumer button), and `groupBox` nesting a second group box with its own title, collapsible, defaultCollapsed and text.",
    "group": "Sibling group boxes rendered side by side in one case, each with its own props and the case's content."
  },
  "ownershipVocabulary": {
    "componentInteractive": "The exact number of controls the component renders in this case: one button.vf-group-box__trigger per collapsible instance that reaches the DOM, zero for a static group.",
    "consumerInteractive": "The exact number of consumer controls that reach the DOM in this case's initial state. Zero when a control sits in closed content, because v-if renders nothing."
  },
  "interactionVocabulary": {
    "$comment": "A case with an `interaction` is driven in the browser with real pointer and key events, then re-measured: the snapshot, the DOM and the accessibility tree are all taken again after the gesture.",
    "steps": "clickButton (a real pointer click at the element's centre; `index` picks a trigger in a group or a nested pair), focusButton, pressKey with Enter or Space.",
    "expect": "Claims checked against the snapshot on every target: `activates` is whether a native click reached a trigger, `keydownPrevented` the per-key record of whether the keydown was prevented, `expanded`/`expandedStates` aria-expanded, `panelPresent`/`panelCount` whether content is in the DOM, `consumerControlCount`, `focusRole`, `controlsResolved` (`panel` or `dangling`), `panelLabelledBy`, `events` the neutral collapsed-change log. `a11y:trigger.expanded` is what assistive technology is told after the gesture.",
    "matches": "The initial case whose DOM the post-interaction DOM must equal on the same target.",
    "consumerInteractive": "The consumer-control budget after the action, when it differs from the case's initial budget."
  },
  "cases": [
