{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemonster.ru/schemas/ui/visual-config-v1.json",
  "title": "CodeMonster UI visual fixture configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themes", "viewports", "stylesheets"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/viewport"
      }
    },
    "stylesheets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "attribute"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
