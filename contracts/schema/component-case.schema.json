{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemonster.ru/schemas/ui/component-case-v1.json",
  "title": "CodeMonster UI component rendering case",
  "description": "Serializable platform-neutral input paired with canonical component HTML.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "props", "slots"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/kebabIdentifier"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "props": {
      "type": "object"
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:default|[a-z][A-Za-z0-9]*)$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\s\"'>/=]+$"
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  },
  "$defs": {
    "kebabIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
