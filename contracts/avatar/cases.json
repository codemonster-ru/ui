{
  "$comment": "Shared VfAvatar cases. Plain data only. The vocabulary is the historical Vue contract at fd793696f50d3be0fcd3788f0f8f751c63869963. The catalog's job is the four-branch fallback chain image -> label -> icon -> default slot: every branch is covered alone, and every adjacent pair is covered together, because a reordering renders an avatar either way and only a case holding both props can tell which one won. The image is an inline data URI so all three targets load byte-identical pixels with no network.",
  "component": "avatar",
  "propVocabulary": {
    "image": "string, default undefined. Wins over everything. Tested for truthiness, so an empty string falls through.",
    "imageAlt": "string, default ''. Always written on the image branch, which makes the image decorative rather than unlabelled.",
    "label": "string, default undefined. Beats the icon and the slot.",
    "icon": "IconName | string, default undefined. Rendered through the neutral icon registry, decorative.",
    "size": "VfControlSize: sm | md | lg. md emits no modifier.",
    "shape": "VfAvatarShape: square | circle. Only circle emits a modifier."
  },
