{
  "$comment": "Shared VfIconButton cases. Plain data only: no Vue, no PHP, no renderer objects. Each adapter maps these neutral fields onto its own API. The vocabulary is the historical Vue contract at fd793696f50d3be0fcd3788f0f8f751c63869963, because the reference defines the baseline; this catalog does not introduce new product behaviour. Props and attrs are split the way the Vue component splits them: props are declared, attrs fall through to the button.",
  "component": "icon-button",
  "propVocabulary": {
    "icon": "Glyph name from the icon registry. Required.",
    "variant": "primary | secondary | success | info | warn | help | danger | contrast | ghost. Defaults to ghost.",
    "size": "sm | md | lg. Defaults to md, which emits no size modifier.",
    "type": "button | submit | reset. Defaults to button."
  },
