{
  "schemaVersion": 1,
  "name": "Switch",
  "slug": "switch",
  "razorTag": "cm-switch",
  "description": "A labeled native checkbox presented with switch semantics.",
  "props": {
    "checked": { "type": "boolean", "required": false, "default": false },
    "value": { "type": "string", "required": false, "default": "on" },
    "label": { "type": "string", "required": false, "default": "" },
    "size": {
      "type": "enum",
      "required": false,
      "default": "md",
      "values": ["sm", "md", "lg"]
    },
    "invalid": { "type": "boolean", "required": false, "default": false },
    "disabled": { "type": "boolean", "required": false, "default": false },
    "required": { "type": "boolean", "required": false, "default": false }
  },
  "slots": {
    "default": { "required": false, "description": "Visible trusted setting label content." },
    "thumb": {
      "required": false,
      "description": "Decorative trusted thumb content. Vue receives the current checked state."
    }
  },
  "events": {
    "change": { "description": "Native change event carrying the current checked state.", "native": true }
  },
  "states": ["default", "checked", "disabled", "invalid"],
  "relatedComponents": ["Field"]
}
