{
  "$comment": "Shared VfSwitch cases. Plain data only. The vocabulary is the historical Vue contract at fd793696f50d3be0fcd3788f0f8f751c63869963. A native checkbox with role=\"switch\" and, deliberately, no aria-checked - the reference sets it on the checkbox and not here, and both are reproduced. Two presentation props the other checkable controls have no equivalent for.",
  "component": "switch",
  "propVocabulary": {
    "modelValue": "Whether the switch is on. Defaults to false.",
    "size": "sm | md | lg. Defaults to md, which still emits a modifier.",
    "static": "A presentation variant with no interactive affordance change.",
    "thumbContrast": "auto | inverse. auto emits no modifier.",
    "invalid": "Adds the invalid modifier and aria-invalid.",
    "disabled": "Disables the input natively.",
    "label": "Label text, overridden by default slot content. Whitespace-only slot content counts as none."
  },
  "cases": [
    {
      "id": "switch/default",
      "title": "An off switch",
      "props": {
        "label": "Notify me"
      },
      "attrs": {},
      "visual": true
    },
