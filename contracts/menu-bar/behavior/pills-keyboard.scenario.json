{
  "schemaVersion": 1,
  "id": "menu-bar-pills-keyboard",
  "case": "menu-bar-pills",
  "steps": [
    { "expect": "attribute", "target": "help", "name": "aria-current", "value": "page" },
    { "action": "focus", "target": "branch-first" },
    { "action": "press", "target": "branch-first", "key": "ArrowDown" },
    { "expect": "focus", "target": "first-command", "value": true },
    { "action": "press", "target": "first-command", "key": "ArrowDown" },
    { "expect": "focus", "target": "nested-branch", "value": true },
    { "action": "press", "target": "nested-branch", "key": "ArrowRight" },
    { "expect": "focus", "target": "nested-command", "value": true },
    { "action": "press", "target": "nested-command", "key": "ArrowLeft" },
    { "expect": "focus", "target": "nested-branch", "value": true },
    { "expect": "attribute", "target": "nested-branch", "name": "aria-expanded", "value": "false" },
    { "action": "press", "target": "nested-branch", "key": "Escape" },
    { "expect": "focus", "target": "branch-first", "value": true },
    { "expect": "visible", "target": "submenu-first", "value": false },
    { "action": "press", "target": "branch-first", "key": "ArrowRight" },
    { "expect": "focus", "target": "help", "value": true },
    { "expect": "attribute", "target": "help", "name": "tabindex", "value": "0" },
    { "action": "press", "target": "branch-first", "key": "ArrowDown" },
    { "action": "click", "target": "first-command" },
    { "expect": "attribute", "target": "first-command", "name": "aria-current", "value": "page" },
    { "expect": "attribute", "target": "help", "name": "aria-current", "value": null },
    { "expect": "focus", "target": "branch-first", "value": true }
  ]
}
