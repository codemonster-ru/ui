{
  "schemaVersion": 1,
  "name": "DatePicker",
  "slug": "date-picker",
  "description": "A labelled calendar for single, multiple, or range selection of ISO dates, months, and years.",
  "props": {
    "value": { "type": "structured", "required": false, "default": "", "valueContract": "date-picker-value" },
    "min": { "type": "nullable", "required": false, "default": null },
    "max": { "type": "nullable", "required": false, "default": null },
    "multiple": { "type": "boolean", "required": false, "default": false },
    "range": { "type": "boolean", "required": false, "default": false },
    "monthPicker": { "type": "boolean", "required": false, "default": false },
    "yearPicker": { "type": "boolean", "required": false, "default": false },
    "size": { "type": "enum", "required": false, "default": "md", "values": ["sm", "md", "lg"] },
    "invalid": { "type": "boolean", "required": false, "default": false },
    "disabled": { "type": "boolean", "required": false, "default": false },
    "readonly": { "type": "boolean", "required": false, "default": false },
    "required": { "type": "boolean", "required": false, "default": false },
    "clearable": { "type": "boolean", "required": false, "default": false },
    "clearLabel": { "type": "string", "required": false, "default": "Clear date" }
  },
  "slots": {},
  "events": {
    "valueChange": {
      "description": "Reports the ISO selection as a single value or, in Vue array modes, a list of values.",
      "payloadContract": "date-picker-value"
    },
    "selectionChange": {
      "description": "In Vanilla array modes, reports multiple or range and the selected ISO values.",
      "payloadContract": "date-picker-selection"
    }
  },
  "states": ["default", "value", "clearable", "invalid", "disabled", "readonly"]
}
