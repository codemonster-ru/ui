{
  "schemaVersion": 1,
  "name": "DatePicker",
  "slug": "date-picker",
  "razorTag": "cm-date-picker",
  "description": "A styled native ISO calendar-date input.",
  "props": {
    "value": { "type": "string", "required": false, "default": "" },
    "min": { "type": "nullable", "required": false, "default": null },
    "max": { "type": "nullable", "required": false, "default": null },
    "size": { "type": "enum", "required": false, "default": "md", "values": ["sm", "md", "lg"] },
    "invalid": { "type": "boolean", "required": false, "default": false },
    "disabled": { "type": "boolean", "required": false, "default": false },
    "readonly": { "type": "boolean", "required": false, "default": false },
    "required": { "type": "boolean", "required": false, "default": false },
    "clearable": { "type": "boolean", "required": false, "default": false },
    "clearLabel": { "type": "string", "required": false, "default": "Clear date" }
  },
  "slots": {},
  "events": { "valueChange": { "description": "Reports the native ISO date string.", "payloadContract": "string" } },
  "states": ["default", "value", "clearable", "invalid", "disabled", "readonly"]
}
