      },
      "interaction": {
        "steps": [
          {
            "action": "focusCheckable"
          },
          {
            "action": "pressKey",
            "key": " "
          }
        ],
        "expect": {
          "liveChecked": false
        }
      },
      "attrs": {},
      "visual": true
    },
    {
      "id": "checkbox/interaction-indeterminate-click",
      "title": "Clicking an indeterminate box resolves it to checked, natively",
      "props": {
        "indeterminate": true,
        "label": "Some selected"
      },
      "interaction": {
        "steps": [
          {
            "action": "clickCheckable"
          }
        ],
        "expect": {
