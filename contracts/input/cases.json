    {
      "id": "input/interaction-wrapper-transition",
      "title": "Typing into a bare clearable control makes the wrapper appear",
      "note": "Exercises the adornment transition itself. The Vue adapter re-renders from the bare branch into the wrapped one and replaces the input element, which loses focus; the Razor adapter always rendered the wrapper and keeps it. The focus difference is a registered framework-specific divergence.",
      "props": {
        "modelValue": "",
        "clearable": true
      },
      "attrs": {
        "name": "interaction-wrapper-transition"
      },
      "interaction": {
        "visualFocus": "blur-after-recording",
        "steps": [
