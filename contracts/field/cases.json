{
  "$comment": "Shared VfField cases. Plain data only: no Vue, no PHP, no renderer objects. Each adapter maps these neutral fields onto its own API. The vocabulary is the historical Vue contract at fd793696f50d3be0fcd3788f0f8f751c63869963. Chosen for semantic coverage rather than a Cartesian grid: every dimension the component actually has appears at least once, interactions declare the outcome they prove, and scripts/ci/field-coverage.mjs is what stops the list eroding. \"field\" is the field component, \"control\" is the VfInput inside its default slot, \"attrs\" fall through to that control and \"fieldAttrs\" to the field root.",
  "component": "field",
  "propVocabulary": {
    "label": "Label text. A field with neither label nor label slot renders no label element.",
    "placement": "top | floating. Defaults to top. Floating additionally requires a label and a control that opts in.",
    "variant": "in | on | over. Defaults to in. Only emitted alongside the floating modifier.",
    "description": "Help text rendered after the control and named in aria-describedby.",
    "error": "Error text rendered last. Its presence alone makes the field invalid.",
    "invalid": "Marks the field invalid without rendering error text.",
    "required": "Renders a decorative asterisk inside the label, if a label exists."
  },
  "cases": [
