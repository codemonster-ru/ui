{
  "schemaVersion": 1,
  "id": "field-floating-date-picker",
  "description": "A floating DatePicker with a portaled calendar and labelled help.",
  "props": {
    "controlId": "field-floating-date-picker",
    "label": "Release date",
    "description": "Published in the release notes.",
    "labelPlacement": "floating",
    "floatingVariant": "in"
  },
  "slots": {
    "default": "<div class=\"cm-date-picker-wrap\" data-cm-controller=\"date-picker\"><input type=\"hidden\" name=\"release_date\" value><button id=\"field-floating-date-picker\" class=\"cm-date-picker cm-date-picker--md cm-date-picker--placeholder\" type=\"button\" role=\"combobox\" aria-haspopup=\"dialog\" aria-controls=\"field-floating-date-picker-calendar\" aria-expanded=\"false\" data-cm-placeholder=\"Choose a date\" data-cm-date-picker-teleport-to=\"body\" aria-describedby=\"field-floating-date-picker-description\"><span class=\"cm-date-picker__value\">Choose a date</span><span class=\"cm-date-picker__icon\" aria-hidden=\"true\"><svg class=\"cm-date-picker__calendar-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><rect x=\"3\" y=\"4.25\" width=\"18\" height=\"16.5\" rx=\"2\"></rect><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line><line x1=\"7.5\" y1=\"2.75\" x2=\"7.5\" y2=\"6\"></line><line x1=\"16.5\" y1=\"2.75\" x2=\"16.5\" y2=\"6\"></line><path d=\"M7.5 12.5h.01M12 12.5h.01M16.5 12.5h.01M7.5 16.5h.01M12 16.5h.01M16.5 16.5h.01\"></path></svg></span></button><button class=\"cm-date-picker__clear\" type=\"button\" aria-label=\"Clear release date\" hidden data-cm-date-picker-clear><span aria-hidden=\"true\"><svg class=\"cm-date-picker__clear-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><line x1=\"5.75\" y1=\"5.75\" x2=\"18.25\" y2=\"18.25\"></line><line x1=\"18.25\" y1=\"5.75\" x2=\"5.75\" y2=\"18.25\"></line></svg></span></button><div id=\"field-floating-date-picker-calendar\" class=\"cm-date-picker__calendar\" role=\"dialog\" aria-label=\"Choose date\" hidden><header class=\"cm-date-picker__header\"><button class=\"cm-date-picker__navigation\" type=\"button\" aria-label=\"Previous month\" data-cm-date-picker-previous><svg class=\"cm-date-picker__navigation-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><polyline points=\"15 5.75 8.75 12 15 18.25\"></polyline></svg></button><span id=\"field-floating-date-picker-calendar-month\" class=\"cm-date-picker__month\" aria-live=\"polite\" data-cm-date-picker-month></span><button class=\"cm-date-picker__navigation\" type=\"button\" aria-label=\"Next month\" data-cm-date-picker-next><svg class=\"cm-date-picker__navigation-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><polyline points=\"9 5.75 15.25 12 9 18.25\"></polyline></svg></button></header><div class=\"cm-date-picker__grid\" role=\"grid\" aria-labelledby=\"field-floating-date-picker-calendar-month\"><div class=\"cm-date-picker__weekdays\" role=\"row\"><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Sun</span><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Mon</span><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Tue</span><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Wed</span><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Thu</span><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Fri</span><span class=\"cm-date-picker__weekday\" role=\"columnheader\">Sat</span></div><div class=\"cm-date-picker__days\" role=\"rowgroup\" data-cm-date-picker-days></div></div></div></div>"
  }
