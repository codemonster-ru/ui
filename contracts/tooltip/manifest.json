{
  "schemaVersion": 1,
  "name": "Tooltip",
  "slug": "tooltip",
  "description": "A focus and hover explanation for a native button or an authored trigger.",
  "props": {
    "id": { "type": "string", "required": false },
    "label": { "type": "string", "required": false },
    "content": { "type": "string", "required": false },
    "text": { "type": "string", "required": false },
    "openDelay": { "type": "number", "required": false },
    "teleportTo": { "type": "string", "required": false },
    "disableTeleport": { "type": "boolean", "required": false, "default": false },
    "defaultVisible": { "type": "boolean", "required": false, "default": false },
    "placement": {
      "type": "enum",
      "required": false,
      "default": "top",
      "values": ["top", "bottom", "start", "end"]
    },
    "delay": {
      "type": "enum",
      "required": false,
      "default": "short",
      "values": ["none", "short", "long"]
    }
  },
  "slots": { "default": { "required": false }, "trigger": { "required": false }, "content": { "required": false } },
  "events": {},
  "states": ["hidden", "visible"]
}
