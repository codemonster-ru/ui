{
  "name": "codemonster-ru/ui-packed-consumer",
  "description": "Isolated packed consumer for CodeMonster UI Annabel Razor.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "codemonster-ru/ui": "^1.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "/tmp/codemonster-ui-extracted",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "/annabel/packages/*",
      "options": {
        "symlink": false
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
