  "stateCases": [
    {
      "id": "hover",
      "route": "core",
      "selector": "[data-test=\"action-geometry-matrix\"] :is(.vf-button, .cm-button):not(:disabled)",
      "pseudoClasses": [
        "hover"
      ]
    },
    {
      "id": "active",
      "route": "core",
      "selector": "[data-test=\"action-geometry-matrix\"] :is(.vf-button, .cm-button):not(:disabled)",
      "pseudoClasses": [
        "active"
      ]
    },
    {
      "id": "focus-visible",
      "route": "core",
      "selector": "[data-test=\"action-geometry-matrix\"] :is(.vf-button, .cm-button):not(:disabled)",
      "pseudoClasses": [
        "focus",
        "focus-visible"
      ]
    },
    {
      "id": "disabled",
      "route": "core",
      "selector": "[data-test=\"action-geometry-matrix\"] :is(.vf-button, .cm-button):disabled"
    },
    {
      "id": "invalid",
      "route": "core",
      "selector": "[data-test=\"form-geometry-matrix\"] [aria-invalid=\"true\"]"
    },
    {
      "id": "selected",
      "route": "core",
      "selector": "[role=\"tab\"][aria-selected=\"true\"]"
    },
    {
      "id": "open",
      "route": "core",
      "selector": ":is(.vf-accordion__trigger, .cm-accordion__trigger)[aria-expanded=\"true\"]",
      "padding": 160
    },
    {
      "id": "closed",
      "route": "core",
      "selector": ":is(.vf-accordion__trigger, .cm-accordion__trigger)[aria-expanded=\"false\"]",
      "padding": 80
    },
    {
      "id": "loading",
      "route": "core",
      "selector": "[data-test=\"action-geometry-matrix\"] [aria-busy=\"true\"]"
    },
    {
      "id": "indeterminate",
      "route": "core",
      "selector": "[role=\"progressbar\"][aria-label=\"Background sync progress\"]"
    },
    {
      "id": "reduced-motion",
      "route": "core",
      "selector": ":is(.vf-progress-bar--animated, .cm-progress-bar--animated)",
      "media": "reduce",
      "assertReducedMotion": true
    }
  ],
  "suite": "states",
  "themes": [
    "light",
    "dark"
  ],
  "viewports": [
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    },
    {
      "name": "desktop",
      "width": 1280,
      "height": 800
    }
  ]
}
